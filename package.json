{
  "name": "helderberto.com",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "eslint . --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@giscus/react": "3.1.0",
    "@types/prismjs": "1.26.6",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "gray-matter": "4.0.3",
    "lucide-react": "0.563.0",
    "markdown-to-jsx": "9.10.3",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "postcss": "^8.5.14"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,json,js}": [
      "prettier --write ."
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
